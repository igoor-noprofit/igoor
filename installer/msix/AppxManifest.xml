<?xml version="1.0" encoding="utf-8"?>
<!--
  IGOOR MSIX manifest (full-trust Win32 / PyInstaller onedir app).

  Identity below uses the REAL Partner Center reservation:
  - Name = reserved app name "IGOOR.IGOOR" (must match exactly)
  - Publisher = the account's Publisher ID (Partner Center, Account settings)
  For LOCAL sideload testing, the package is signed with a self-signed cert
  whose subject equals the Publisher string exactly (make_test_cert.ps1);
  test machines must trust that cert (TrustedPeople + Root). Store
  submissions are re-signed by Microsoft - end users see no prompts.
-->
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
         xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
         xmlns:desktop6="http://schemas.microsoft.com/appx/manifest/desktop/windows10/6"
         xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
         IgnorableNamespaces="desktop6">

  <Identity Name="IGOOR.IGOOR"
            Version="1.1.5.0"
            ProcessorArchitecture="x64"
            Publisher="CN=AFF811DC-40E0-4A1D-A8C8-AA38A5208E53" />

  <Properties>
    <DisplayName>IGOOR</DisplayName>
    <PublisherDisplayName>IGOOR</PublisherDisplayName>
    <Logo>assets\StoreLogo.png</Logo>
    <!-- All user data (cloned voices, memory, settings) must live in the REAL
         %APPDATA%\igoor so it survives uninstall (our privacy policy promises
         this) and stays accessible to users, backups and the classic Inno
         Setup channel. Default MSIX virtualization would hide it inside the
         per-package container, which is deleted on uninstall. -->
    <desktop6:FileSystemWriteVirtualization>disabled</desktop6:FileSystemWriteVirtualization>
    <desktop6:RegistryWriteVirtualization>disabled</desktop6:RegistryWriteVirtualization>
  </Properties>

  <Resources>
    <Resource Language="en-US" />
    <Resource Language="fr-FR" />
    <Resource Language="it-IT" />
  </Resources>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <rescap:Capability Name="unvirtualizedResources" />
    <DeviceCapability Name="microphone" />
  </Capabilities>

  <Applications>
    <Application Id="IGOOR"
                 Executable="igoor.exe"
                 EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="IGOOR"
                          Description="Assistive eye-tracking communication app for people with neurodegenerative diseases."
                          BackgroundColor="#121617"
                          Square44x44Logo="assets\Square44x44Logo.png"
                          Square150x150Logo="assets\Square150x150Logo.png" />
    </Application>
  </Applications>

</Package>
